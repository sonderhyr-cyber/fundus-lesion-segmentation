diff --git a/configs/lesion/exp/e1_tversky_split613.py b/configs/lesion/exp/e1_tversky_split613.py
new file mode 100644
index 0000000..3cd7050
--- /dev/null
+++ b/configs/lesion/exp/e1_tversky_split613.py
@@ -0,0 +1,22 @@
+_base_ = './baseline_split613.py'
+
+# ============================================================
+# exp/e1_tversky_split613.py — E1: replace per-class Dice with
+# Tversky loss (alpha=0.3 -> beta=0.7, FN-penalizing).
+# Hypothesis: MA/HE recall is limited by the balanced Dice
+# surface; Tversky with beta>alpha pushes the model to reduce
+# false negatives without the class-weight coupling problem
+# that made 板块三 weighting fail.
+# ============================================================
+
+model = dict(
+    decode_head=dict(
+        loss_decode=dict(
+            type='BinaryLoss',
+            loss_type='tversky',
+            loss_weight=1.0,
+            smooth=1e-5,
+            loss_hyper=dict(alpha=0.3),
+        )
+    )
+)
